# Copy to .env and fill in. .env is NOT committed (it contains the API key and the webhook secret).

# Port of our game server (HTTP + WebSocket on /ws)
PORT=3000

# Partner stats API (the other pair's server)
STATS_API_URL=http://localhost:4000
STATS_API_KEY=dev-api-key
STATS_WEBHOOK_SECRET=dev-webhook-secret
STATS_TIMEOUT_MS=2500
STATS_COOLDOWN_SECONDS=10

# Our webhook URL as the partner sees it, e.g. http://192.168.1.20:3000/webhooks/stats
# When set, the server subscribes itself at the partner (POST /subscriptions) on start.
PUBLIC_WEBHOOK_URL=

# Development bot: joins when a player waits alone (bot games do not change ELO)
BOT_ENABLED=false
BOT_JOIN_AFTER_SECONDS=8

# Where the outbox and the rating cache are saved
DATA_DIR=./data
# Offline players without a game are forgotten after this time
OFFLINE_PLAYER_TTL_SECONDS=600
